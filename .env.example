# Atlas connection string (Atlas/Compass → Connect → Drivers). URL-encode special characters in the password (@ → %40).
MONGODB_URI=mongodb+srv://<db-user>:<url-encoded-password>@<cluster-host>/mri_demo?retryWrites=true&w=majority

# Optional — only needed if the data uses other names than the defaults
# MONGODB_DB=mri_demo
# REPORT_COLL=report
# IMAGE_COLL=mri_image
